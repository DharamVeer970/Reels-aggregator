# Copy this file to .env and fill in the values you have.
# Never commit real credentials.
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
CACHE_TTL_SECONDS=60

# YouTube Data API v3. Set either a normal API key or an OAuth access token.
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_QUERY=shorts

# Instagram Graph API. Leave blank for now.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Apify. The Moj Actor below was verified against its public input schema.
APIFY_TOKEN=
APIFY_MOJ_ACTOR_ID=actor_id
APIFY_MOJ_INPUT_JSON={"profiles":[{"profile":"moj","maxVideos":10}]}

# Optional Actors. No verified public Actor exists for these as of 2026-09-24
# (Apify Store search for josh/roposo/triller/chingari/mx-takatak returns 0 relevant hits).
# Leave blank until a verified Actor is selected. Blank sources are skipped independently.
APIFY_JOSH_ACTOR_ID=
APIFY_JOSH_INPUT_JSON={}
APIFY_ROPOSO_ACTOR_ID=
APIFY_ROPOSO_INPUT_JSON={}
APIFY_TRILLER_ACTOR_ID=
APIFY_TRILLER_INPUT_JSON={}

# Verified extra platforms (added 2026-09-24).
# TikTok: clockworks/tiktok-scraper (291k users). Input: hashtags + resultsPerPage.
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
APIFY_TIKTOK_INPUT_JSON={"hashtags":["fyp"],"resultsPerPage":30,"profileScrapeSections":["videos"],"profileSorting":"latest"}
# Facebook Reels: apify/facebook-reels-scraper (official, 7.4k users). Input: page URLs + resultsLimit.
APIFY_FACEBOOK_ACTOR_ID=apify/facebook-reels-scraper
APIFY_FACEBOOK_INPUT_JSON={"startUrls":[{"url":"https://www.facebook.com/9GAGCute"}],"resultsLimit":30}
